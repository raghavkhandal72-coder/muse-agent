# Meta Muse Configuration
# Place your active API keys below:

# 1. NVIDIA NIM (Recommended default - https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# 2. Alternative Providers (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# 3. Server Configuration
MUSE_PORT=8765
MUSE_HOST=127.0.0.1
MUSE_ENABLE_TUNNEL=true
